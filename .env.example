# Copy to .env on the server only (chmod 600 .env). Never commit .env or paste keys in chat.
# Kraken API key: Query Funds, Query Open/Closed Orders & Trades, Create & Modify Orders,
# Cancel/Close Orders. NEVER enable Withdraw Funds. Optionally restrict it to the server's IP.
# Profile the paper/live services run (default: configs/profiles/balanced-paper.yaml)
# TRADER_PROFILE=configs/profiles/<name>.yaml
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Optional phone alerts, e.g. ntfy (free app): https://ntfy.sh/<a-long-random-topic-name>
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=ntfy
